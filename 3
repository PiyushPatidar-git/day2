#include<iostream>
using namespace std;

int main(){
    int n;
    cin>>n;

    int p = 0;
    int s = 1;
      cout<<p<<" ";
        cout<<s<<" ";
    for(int i=0; i<n; i++){
        
        int next;
        next = p+s;
        cout<<next<<" ";
        p = s;
        s = next;
    }
    return 0;
}
